# Action refs verified read-only via api.github.com/repos/actions/{name}/git/ref/tags/{tag}.
# INERT DRAFT outside .github/workflows. No repository was created or deployed.
# Activation requires user approval of a PRIVATE collector repo, protected
# environment, reviewed source/body policy, provider secrets, provider smoke test and review of
# the pinned dependency/action versions. The public AlgoWen site remains separate.
name: AlgoWen private candidate review (draft)
on:
  schedule:
    - cron: '0 1 * * 1'
  workflow_dispatch:
    inputs:
      source_url:
        description: 'Optional approved public article URL (never private text/secrets)'
        required: false
        type: string
permissions:
  contents: read
concurrency:
  group: algotop-candidates
  cancel-in-progress: false
jobs:
  candidates:
    # Fail closed on public repository. Activation and transfer consent are separate.
    if: github.event.repository.private == true && vars.ALGOTOP_COLLECTION_ENABLED == 'true' && vars.ALGOTOP_ALLOW_LLM_CONTENT_TRANSFER == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: algotop-collection-review
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # verified v4 ref
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # verified v5 ref
        with:
          python-version: '3.12'
      - name: Install optional server SDK
        run: python -m pip install -r tools/collection/requirements-llm.txt
      - name: Offline checks
        run: |
          python -m unittest discover -s tools/collection -v
          npm test
          node scripts/build.js
      - name: Discover, extract approved bodies, queue private review
        env:
          OPENAI_API_KEY: ${{ secrets.ALGOTOP_OPENAI_API_KEY }}
          ALGOTOP_LLM_MODEL: ${{ vars.ALGOTOP_LLM_MODEL }}
          ALGOTOP_LLM_BASE_URL: ${{ vars.ALGOTOP_LLM_BASE_URL }}
          ALGOTOP_TRUST_CUSTOM_ENDPOINT: ${{ vars.ALGOTOP_TRUST_CUSTOM_ENDPOINT }}
        run: >-
          python tools/collection/run_weekly.py --network --direct-public-egress
          --allow-llm-content-transfer --max-documents 3 --max-seconds 240
          --output .collection/private-weekly-review.json
      - name: Optional manual approved URL
        if: github.event_name == 'workflow_dispatch' && inputs.source_url != ''
        env:
          SOURCE_URL: ${{ inputs.source_url }}
          OPENAI_API_KEY: ${{ secrets.ALGOTOP_OPENAI_API_KEY }}
          ALGOTOP_LLM_MODEL: ${{ vars.ALGOTOP_LLM_MODEL }}
          ALGOTOP_LLM_BASE_URL: ${{ vars.ALGOTOP_LLM_BASE_URL }}
          ALGOTOP_TRUST_CUSTOM_ENDPOINT: ${{ vars.ALGOTOP_TRUST_CUSTOM_ENDPOINT }}
        run: >-
          python tools/collection/pipeline.py --fetch-url "$SOURCE_URL"
          --direct-public-egress --policy tools/collection/policy.json
          --allow-llm-content-transfer --output .collection/private-manual-review.json
      - name: Upload private pending candidates, never original documents
        if: ${{ !cancelled() && github.event.repository.private == true }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # verified v4 ref
        with:
          name: private-candidates-review-only
          path: |
            .collection/private-weekly-review.json
            .collection/private-manual-review.json
          retention-days: 3
          if-no-files-found: error
      # No data merge, Pages deploy, commits, issue creation or auto-approval.
